PORT=4000
JWT_SECRET=change-this-to-a-long-random-secret
CLIENT_URL=http://localhost:5173
PAYMENT_WEBHOOK_SECRET=change-this-to-a-long-random-secret

# پرداخت با کارت (Stripe) — اختیاری. تا وقتی خالی باشند، پرداخت با کارت
# غیرفعال می‌ماند و فقط حواله بانکی (تایید دستی توسط ادمین) در دسترس است.
# STRIPE_SECRET_KEY را از https://dashboard.stripe.com/apikeys بگیرید
# و STRIPE_WEBHOOK_SECRET را هنگام ساخت وبهوک برای /api/payments/stripe-webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# آپلود ویدیو روی Bunny Stream — اختیاری. تا وقتی خالی باشند، ویدیوها مثل
# قبل روی دیسک سرور (backend/uploads) ذخیره می‌شوند. کتابخانه و کلید را از
# پنل Bunny Stream (Stream > Library > API) بگیرید.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
